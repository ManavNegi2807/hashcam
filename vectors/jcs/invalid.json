{
  "set": "inputs a conforming parser must reject",
  "protocol_version": "abb/1",
  "generator": "vectors/tools/generate.py (Python reference, cross-check only)",
  "note": "PROTOCOL.md 3.2 and 3.3. `reason` is the stable rejection code.",
  "cases": [
    {
      "id": "jcs-bad-float",
      "desc": "fractional number",
      "input_text": "{\"a\":1.5}",
      "expect": {
        "result": "REJECT",
        "reason": "FLOAT_NOT_ALLOWED"
      }
    },
    {
      "id": "jcs-bad-exponent",
      "desc": "exponent notation",
      "input_text": "{\"a\":1e2}",
      "expect": {
        "result": "REJECT",
        "reason": "FLOAT_NOT_ALLOWED"
      }
    },
    {
      "id": "jcs-bad-nan",
      "desc": "NaN literal",
      "input_text": "{\"a\":NaN}",
      "expect": {
        "result": "REJECT",
        "reason": "NAN_OR_INFINITY"
      }
    },
    {
      "id": "jcs-bad-infinity",
      "desc": "Infinity literal",
      "input_text": "{\"a\":Infinity}",
      "expect": {
        "result": "REJECT",
        "reason": "NAN_OR_INFINITY"
      }
    },
    {
      "id": "jcs-bad-minus-zero",
      "desc": "minus zero",
      "input_text": "{\"a\":-0}",
      "expect": {
        "result": "REJECT",
        "reason": "MINUS_ZERO"
      }
    },
    {
      "id": "jcs-bad-leading-zero",
      "desc": "leading zero",
      "input_text": "{\"a\":01}",
      "expect": {
        "result": "REJECT",
        "reason": "LEADING_ZERO"
      }
    },
    {
      "id": "jcs-bad-plus",
      "desc": "explicit plus sign",
      "input_text": "{\"a\":+1}",
      "expect": {
        "result": "REJECT",
        "reason": "NUMBER_FORM_INVALID"
      }
    },
    {
      "id": "jcs-bad-duplicate-key",
      "desc": "duplicate object key",
      "input_text": "{\"a\":1,\"a\":2}",
      "expect": {
        "result": "REJECT",
        "reason": "DUPLICATE_KEY"
      }
    },
    {
      "id": "jcs-bad-int-too-large",
      "desc": "integer above 2^53-1",
      "input_text": "{\"a\":9007199254740992}",
      "expect": {
        "result": "REJECT",
        "reason": "INT_OUT_OF_RANGE"
      }
    },
    {
      "id": "jcs-bad-lone-surrogate",
      "desc": "lone high surrogate in a string",
      "input_text": "{\"a\":\"\\ud800\"}",
      "expect": {
        "result": "REJECT",
        "reason": "LONE_SURROGATE"
      }
    },
    {
      "id": "jcs-bad-trailing-data",
      "desc": "two documents in one input",
      "input_text": "{} {}",
      "expect": {
        "result": "REJECT",
        "reason": "TRAILING_DATA"
      }
    },
    {
      "id": "jcs-bad-syntax",
      "desc": "unterminated object",
      "input_text": "{",
      "expect": {
        "result": "REJECT",
        "reason": "SYNTAX_ERROR"
      }
    },
    {
      "id": "jcs-bad-depth",
      "desc": "nesting deeper than 16",
      "input_text": "[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]",
      "expect": {
        "result": "REJECT",
        "reason": "DEPTH_EXCEEDED"
      }
    },
    {
      "id": "jcs-bad-string-too-long",
      "desc": "single string longer than 16384 characters",
      "input_text": "{\"a\":\"\"}",
      "expect": {
        "result": "REJECT",
        "reason": "STRING_TOO_LONG"
      }
    },
    {
      "id": "jcs-bad-invalid-utf8",
      "desc": "invalid UTF-8 byte sequence inside a string",
      "input_b64": "eyJhIjoi//4ifQ==",
      "expect": {
        "result": "REJECT",
        "reason": "INVALID_UTF8"
      }
    }
  ]
}
