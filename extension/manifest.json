{
  "manifest_version": 3,
  "name": "HashCam Recorder",
  "short_name": "HashCam",
  "version": "0.1.0",
  "description": "A flight recorder for AI agents in your browser: records what they do, holds risky steps for your passkey, and seals a receipt you can verify.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open the HashCam Recorder",
    "default_icon": { "32": "icons/icon32.png", "128": "icons/icon128.png" }
  },
  "icons": { "32": "icons/icon32.png", "128": "icons/icon128.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "tabs", "webNavigation", "scripting", "downloads"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*", "<all_urls>"],
  "web_accessible_resources": [
    { "resources": ["blocked.html", "blocked.js", "panel.css", "vendor/plus-jakarta-sans.woff2"],
      "matches": ["https://*/*", "http://*/*"], "use_dynamic_url": true }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*"
  }
}
